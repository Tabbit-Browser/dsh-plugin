{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    // Type-only resolution of dsh packages against a local deepseek-harness
    // checkout's built declarations. Runtime resolution happens inside the dsh
    // profile (peerDependencies + the $DSH_HOME/profiles/node_modules fallback),
    // so these paths never leak into emitted JS.
    // All entries point at ./.dsh-harness — a gitignored symlink, not a real
    // directory — so this file never needs per-developer edits. Point that one
    // symlink at your own checkout with `npm run link-harness -- /path/to/deepseek-harness`
    // (see README's Development section).
    "paths": {
      "@deepseek-ai/cordis": ["./.dsh-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["./.dsh-harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-web": ["./.dsh-harness/packages/web/web/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-settings": ["./.dsh-harness/packages/settings/settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-skill": ["./.dsh-harness/packages/skill/skill/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["./.dsh-harness/packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-jobs": ["./.dsh-harness/packages/jobs/jobs/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["./.dsh-harness/packages/core/session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./.dsh-harness/packages/core/session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-util-values": ["./.dsh-harness/packages/util/values/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["./.dsh-harness/packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-attachment": ["./.dsh-harness/packages/attachment/attachment/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-commands": ["./.dsh-harness/packages/interaction/commands/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-system-prompt": ["./.dsh-harness/packages/core/system-prompt/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["./.dsh-harness/packages/host/webserver/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-user-approval": ["./.dsh-harness/packages/interaction/user-approval/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
